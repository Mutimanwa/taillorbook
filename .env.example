# ============================================================
# SokoMarket — variables d'environnement (EXEMPLE)
# ============================================================
#
# Ce fichier est un MODÈLE : copiez-le en `.env` (non commité) et ne
# conservez JAMAIS vos vraies clés dans Git.
#
# L'application lit les secrets au moment de la compilation via
# `--dart-define` (voir lib/config/environment/app_env.dart) :
#
#   flutter run --dart-define=IMGBB_API_KEY=votre_cle
#
# ou de façon permanente dans .vscode/launch.json / vos scripts :
#
#   flutter build apk --release --dart-define=IMGBB_API_KEY=votre_cle

# Clé API ImgBB — https://api.imgbb.com/ (gratuite, requise pour
# l'upload des images produits).
IMGBB_API_KEY=
